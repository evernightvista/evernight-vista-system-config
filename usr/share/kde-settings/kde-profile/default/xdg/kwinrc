[Wayland]
InputMethod[$e]=/usr/share/applications/org.fcitx.Fcitx5.desktop
VirtualKeyboardEnabled=true

[Effect-aeroglassblur]
AeroBrightness=93
AeroHue=180
AeroSaturation=75
BlurFirefox=
BlurStrength=4
FollowPlasmaAccentColor=true
OpaqueKrunner=false
OpaqueOSD=false
PaintAsTranslucent=true
ReflectionIntensity=100

[Effect-blur]
BlurStrength=1
NoiseStrength=0
Saturation=100

[Effect-loginaero]
FadeToBlack=true

[Plugins]
aeroglassblurEnabled=true
aeroglideEnabled=true
dimscreenEnabled=false
dimscreenaeroEnabled=true
trackmouseEnabled=true
glideEnabled=false
smodglowEnabled=true
smodpeekeffectEnabled=true
smodpeekscriptEnabled=true
windowapertureEnabled=false
scaleEnabled=false
squashEnabled=true
blurEnabled=true

[Round-Corners]
ActiveOutlineUseCustom=false
ActiveOutlineUsePalette=true
ActiveSecondOutlineUseCustom=false
ActiveSecondOutlineUsePalette=true
AnimationDuration=220
DisableRoundTile=true
InactiveCornerRadius=15
InactiveOutlineThickness=0
InactiveOutlineUseCustom=false
InactiveOutlineUsePalette=true
InactiveSecondOutlineThickness=0
InactiveSecondOutlineUseCustom=false
InactiveSecondOutlineUsePalette=true
OutlineThickness=0
SecondOutlineThickness=0
Size=15

[Effect-glide]
Duration=220
InDistance=50
InRotationAngle=10
OutDistance=50
OutRotationAngle=10

[TabBox]
DelayTime=0
ShowDesktopMode=1
LayoutName=flipswitch

[TabBoxAlternative]
DelayTime=0
ShowDesktopMode=1
LayoutName=flipswitch

[Effect-shakecursor]
Magnification=7

[org.kde.kdecoration2]
BorderSize=None
BorderSizeAuto=false
ButtonsOnLeft=MS
ButtonsOnRight=HIAX
library=org.kde.klassy
theme=Klassy
CloseOnDoubleClickOnMenu=true

[Xwayland]
XwaylandEavesdrops=All
XwaylandEavesdropsMouse=true
